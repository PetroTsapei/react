{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-circular": "npx --yes madge --circular --extensions ts,tsx src",
    "lint": "eslint src && npm run check-circular",
    "lint:report": "eslint --format json --output-file lint-report.json src",
    "prettier": "prettier --check src",
    "prettier:fix": "prettier --write src",
    "audit:fix": "npm audit fix",
    "audit:report": "npm audit --json > audit-report.json",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.9.0",
    "happy-dom": "^15.7.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "typescript": "5.5.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": "eslint",
    "**/*": "prettier --write --ignore-unknown"
  }
}
